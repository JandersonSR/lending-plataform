<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    O processo. Não tem regra de negócio: lê o perfil (quais módulos, qual papel), liga os blocos
    transversais (observabilidade, auth, mensageria, OpenAPI, ProblemDetails, rate limit, health) e
    pede a cada módulo ativo que se registre e mapeie seus endpoints.
  -->
  <PropertyGroup>
    <RootNamespace>CreditFlow.Host</RootNamespace>
    <!-- "public partial class Program" existe para o WebApplicationFactory dos testes de integração. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <UserSecretsId>creditflow-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\CreditFlow.BuildingBlocks\CreditFlow.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Modules\Clientes\CreditFlow.Modules.Clientes\CreditFlow.Modules.Clientes.csproj" />
    <ProjectReference Include="..\..\Modules\Simulacao\CreditFlow.Modules.Simulacao\CreditFlow.Modules.Simulacao.csproj" />
    <ProjectReference Include="..\..\Modules\Propostas\CreditFlow.Modules.Propostas\CreditFlow.Modules.Propostas.csproj" />
    <ProjectReference Include="..\..\Modules\Pagamentos\CreditFlow.Modules.Pagamentos\CreditFlow.Modules.Pagamentos.csproj" />
    <ProjectReference Include="..\..\Modules\Notificacoes\CreditFlow.Modules.Notificacoes\CreditFlow.Modules.Notificacoes.csproj" />
  </ItemGroup>

</Project>
