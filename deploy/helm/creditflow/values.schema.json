{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Valores do chart creditflow",
  "type": "object",
  "required": ["imagem", "perfis", "configuracao", "segredos", "rotas", "padrao", "migracoes"],
  "properties": {
    "imagem": {
      "type": "object",
      "required": ["repositorio"],
      "properties": {
        "repositorio": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "ambiente": { "type": "string" },
    "configuracao": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "rotas": {
      "type": "object",
      "properties": {
        "tipo": { "enum": ["gateway", "ingress", "nenhum"] },
        "hosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "perfis": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["habilitado", "papel", "modulos", "sondas", "recursos"],
        "properties": {
          "habilitado": { "type": "boolean" },
          "papel": { "enum": ["api", "worker"] },
          "modulos": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["Clientes", "Simulacao", "Propostas", "Pagamentos", "Notificacoes"] }
          },
          "segredos": { "type": "array", "items": { "type": "string" } },
          "replicas": { "type": "integer", "minimum": 0 },
          "servico": { "type": "boolean" },
          "preStopSegundos": { "type": "integer", "minimum": 0 },
          "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
          "sondas": {
            "type": "object",
            "required": ["startup", "readiness", "liveness"],
            "additionalProperties": {
              "type": "object",
              "required": ["caminho"],
              "properties": {
                "caminho": { "type": "string", "pattern": "^/" },
                "periodSeconds": { "type": "integer", "minimum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1 },
                "timeoutSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "autoescala": {
            "type": "object",
            "required": ["tipo"],
            "properties": {
              "tipo": { "enum": ["hpa", "keda", "nenhum"] },
              "minimo": { "type": "integer", "minimum": 0 },
              "maximo": { "type": "integer", "minimum": 1 },
              "cpuAlvo": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "allOf": [
              {
                "if": { "properties": { "tipo": { "const": "hpa" } } },
                "then": { "required": ["minimo", "maximo", "cpuAlvo"] }
              },
              {
                "if": { "properties": { "tipo": { "const": "keda" } } },
                "then": { "required": ["minimo", "maximo", "kafka"] }
              }
            ]
          },
          "rotas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["caminho"],
              "properties": { "caminho": { "type": "string", "pattern": "^/" } }
            }
          },
          "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
        }
      }
    }
  }
}
