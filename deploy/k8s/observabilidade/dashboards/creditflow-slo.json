{
  "uid": "creditflow-slo",
  "title": "CreditFlow: SLOs e jornadas de crédito",
  "tags": [
    "creditflow",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLOs (30 dias)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Budget restante: simulação (5xx)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "creditflow:slo_simulacao_erros:budget_restante",
          "legendFormat": "budget"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Budget restante: simulação (latência)",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "creditflow:slo_simulacao_lentas:budget_restante",
          "legendFormat": "budget"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Budget restante: desembolso em 5 min",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "creditflow:slo_desembolso_ruins:budget_restante",
          "legendFormat": "budget"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taxa de queima (1h) por SLO",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "creditflow:slo_simulacao_erros:razao1h / 0.005",
          "legendFormat": "simulação 5xx"
        },
        {
          "refId": "B",
          "expr": "creditflow:slo_simulacao_lentas:razao1h / 0.01",
          "legendFormat": "simulação lenta"
        },
        {
          "refId": "C",
          "expr": "creditflow:slo_desembolso_ruins:razao1h / 0.01",
          "legendFormat": "desembolso"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Simulação (api-simulacao)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requisições por segundo, por status",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"creditflow-api-simulacao\",http_route=~\"/v1/simulacoes.*\"}[5m]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latência p50 / p95 / p99",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"creditflow-api-simulacao\",http_route=~\"/v1/simulacoes.*\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"creditflow-api-simulacao\",http_route=~\"/v1/simulacoes.*\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"creditflow-api-simulacao\",http_route=~\"/v1/simulacoes.*\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Réplicas e CPU (HPA)",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"creditflow-api-simulacao\"}",
          "legendFormat": "réplicas"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"creditflow\",pod=~\"creditflow-api-simulacao-.*\",container=\"creditflow\"}[2m]))",
          "legendFormat": "CPU (cores)"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Simulações por sistema",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (creditflow_amortizacao_sistema) (rate(creditflow_simulacoes_total[5m]))",
          "legendFormat": "{{creditflow_amortizacao_sistema}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tempo de CPU do cálculo (p99)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(creditflow_simulacao_duracao_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Jornada de crédito e desembolso",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Propostas por resultado",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (creditflow_resultado) (increase(creditflow_propostas_total[15m]))",
          "legendFormat": "{{creditflow_resultado}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Desembolsos por resultado",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (creditflow_resultado, creditflow_motivo) (increase(creditflow_desembolsos_total[15m]))",
          "legendFormat": "{{creditflow_resultado}} {{creditflow_motivo}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Contrato -> desembolso (p50 / p95)",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(creditflow_desembolso_duracao_seconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(creditflow_desembolso_duracao_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Kafka e dependências",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Lag por grupo e tópico",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"creditflow-.*\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Réplicas do worker-pagamentos (KEDA)",
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"creditflow\",deployment=\"creditflow-worker-pagamentos\"}",
          "legendFormat": "réplicas"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Outbox e DLT",
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(creditflow_mensageria_outbox_publicadas_total[5m]))",
          "legendFormat": "publicadas {{service_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (rate(creditflow_mensageria_consumidor_dlt_total[5m]))",
          "legendFormat": "DLT {{service_name}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Runbooks",
      "url": "https://github.com/JandersonSR/lending-plataform/tree/main/docs/runbooks",
      "type": "link"
    }
  ]
}