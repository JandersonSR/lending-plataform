<Project>
  <!--
    Central Package Management (CPM): a VERSÃO de cada pacote mora aqui, uma vez só.
    Nos .csproj vai só <PackageReference Include="Nome" /> (sem Version). Assim os 15+ projetos
    nunca ficam com versões diferentes do mesmo pacote.
    Versões conferidas no nuget.org em 30/out/2026 (estável mais recente, salvo nota).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Dependências transitivas também respeitam as versões daqui (evita duas versões do mesmo pacote no grafo). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core e extensões (acompanham o runtime 10.0.x)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <!-- HybridCache tem ciclo próprio de versões (mensal), por isso 10.11 e não 10.0.x. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
  </ItemGroup>

  <ItemGroup Label="Dados">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.20" />
  </ItemGroup>

  <ItemGroup Label="Mensageria">
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

  <ItemGroup Label="Observabilidade (OpenTelemetry .NET)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!--
      xUnit v3 na linha 3.x de propósito: a 4.0 (ago/2026) passou a usar o Microsoft Testing Platform v2
      por padrão, o que muda o "dotnet test". Migrar para a 4.x é um exercício do módulo 12.
    -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.16.0" />
    <!-- Sem release desde 2021, mas estável e ainda a referência para testes de arquitetura em .NET. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
